# Copy to apps/web/.env.local. NEXT_PUBLIC_* values are inlined at build time.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8787
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable (anon) key from `supabase status -o env`. Public by design.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare Turnstile site key. Leave empty in self-hosted mode.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
