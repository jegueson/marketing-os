{
  "name": "marketing-os-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "marketing-os-web"
    },
    {
      "binding": "API",
      "service": "marketing-os-api"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "NEXT_PUBLIC_API_BASE_URL": "https://marketing-os-api.gabriel-candido.workers.dev"
  }
}
