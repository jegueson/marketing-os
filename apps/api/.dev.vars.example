# Copy to apps/api/.dev.vars for `wrangler dev`. Values come from `supabase status -o env`.
MOS_DEPLOYMENT_MODE=self_hosted
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
# Cloud projects with asymmetric signing keys: https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# Local `supabase start` signs with a shared secret: JWT_SECRET from `supabase status -o env`.
SUPABASE_JWT_SECRET=
# Local Mailpit from `supabase start`. In cloud, the EMAIL binding is used instead.
MAILPIT_URL=http://127.0.0.1:54324
EMAIL_FROM=noreply@marketing-os.local
# Required in cloud mode; lead intake returns 503 without it.
TURNSTILE_SECRET_KEY=
# 32-byte base64 key for credential encryption (`openssl rand -base64 32`).
# Use the same value for `mos setup`. Back this up. Losing it makes stored tokens unreadable.
# On rotation, point MOS_DATA_KEY at the new key, bump MOS_DATA_KEY_VERSION, and keep the old
# material as MOS_DATA_KEY_V1 until every credential row has been re-read.
MOS_DATA_KEY=
# MOS_DATA_KEY_VERSION=1
# MOS_DATA_KEY_V1=
# Optional. Shared by GA4 and Google Ads when those connector flags are enabled.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Test-account developer token. Required only when connector.google-ads is enabled.
# GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional. Required only when connector.hubspot is enabled.
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# Optional. Required only when connector.meta is enabled. ads_read still needs App Review.
# META_APP_ID=
# META_APP_SECRET=
